# Local secrets for `npm run preview` (wrangler pages dev). Copy to .dev.vars — it is git-ignored.
# Run `npm run check:payments` afterwards: it reports each setting by name and never prints values.
ALINMAPAY_ENV=sandbox
ALINMAPAY_MERCHANT_KEY=
ALINMAPAY_TERMINAL_ID=
ALINMAPAY_TERMINAL_PASSWORD=
ALINMAPAY_PAY_REQUEST_URL=https://pg.alinmapay.com.sa/SB_Transactions/v2/payments/pay-request
SITE_URL=http://localhost:8788
# Sandbox payments use the LOCAL test database from supabase/local-test (see its README for the test key).
# Hosted Supabase is refused in sandbox mode unless ALLOW_SANDBOX_ON_HOSTED_DB=true (only for a dedicated test project).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# IP of the machine/server calling AlinmaPay. The Inquiry needs it (without it: 622 Invalid IP Address).
ALINMAPAY_MERCHANT_IP=
# Order emails (Resend, https://resend.com). Optional locally; leave empty to send nothing.
RESEND_API_KEY=
EMAIL_FROM=LAS CAFE <orders@lascafe.sa>
ORDER_ALERT_EMAIL=
# Aramex shipping (optional). ARAMEX_ENV has no default: uat = Aramex test system, production = real billed shipments.
# On Cloudflare add every one of these as type Secret.
ARAMEX_ENV=uat
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ENTITY=
ARAMEX_SHIPPER_NAME=LAS CAFE
ARAMEX_SHIPPER_PHONE=
ARAMEX_SHIPPER_EMAIL=
ARAMEX_SHIPPER_CITY=Riyadh
ARAMEX_SHIPPER_ADDRESS=
# Optional, to be confirmed by Aramex: ARAMEX_PRODUCT_TYPE=ONP (or CDS / OND)  ARAMEX_LABEL_REPORT_ID=9729 (or 9201)
