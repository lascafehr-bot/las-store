# Las Café store — NEW dedicated Supabase project only.
# Copy to .env.local and fill in values from the Supabase project settings.
# Never commit real keys. Never put the service-role key in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AlinmaPay payments (server-side ONLY: Cloudflare Pages Functions in /functions) ---
# Put these in Cloudflare Pages → Settings → Variables and Secrets (type: Secret), and in a local
# .dev.vars file for `npm run preview`. NEVER use a NEXT_PUBLIC_ prefix and never commit real values.
# "sandbox" or "production" (required, no default). Drives the order label and safety checks.
ALINMAPAY_ENV=
ALINMAPAY_MERCHANT_KEY=
ALINMAPAY_TERMINAL_ID=
ALINMAPAY_TERMINAL_PASSWORD=
# Sandbox: optional. Production: REQUIRED, set to the exact endpoint AlinmaPay gave you for live.
ALINMAPAY_PAY_REQUEST_URL=
# Public https origin of the store (local preview: http://localhost:8788)
SITE_URL=
# Sandbox testing: use the local kit in supabase/local-test (http://127.0.0.1:54321). Never point sandbox at the
# production project. The service-role key is a secret: server-side only.
# ALLOW_SANDBOX_ON_HOSTED_DB=true is only for a dedicated hosted TEST project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
